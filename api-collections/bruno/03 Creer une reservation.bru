meta {
  name: 03 Créer une réservation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/booking
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "firstname": "Wassim",
    "lastname": "Bruno",
    "totalprice": 240,
    "depositpaid": true,
    "bookingdates": { "checkin": "2027-01-10", "checkout": "2027-01-12" },
    "additionalneeds": "Breakfast"
  }
}

script:post-response {
  bru.setVar("bookingId", res.getBody().bookingid);
}

tests {
  test("TC-API-03 - la réservation est créée", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().bookingid).to.be.a("number");
    expect(res.getBody().booking.lastname).to.equal("Bruno");
  });
}
